<%
const apps = [
  { name: 'subscriptions management', desc: 'simple management app for your subscriptions', img: 'sm-logo-512x512.webp', legal: 'subscriptions-management' },
  { name: 'focus', desc: 'focus on things that matter', img: 'focus-logo-512x512.webp', legal: 'focus' },
  { name: 'delay your purchases', desc: 'buy things that you actually need', img: 'dyp-logo-512x512.webp', legal: 'delay-your-purchases' },
  { name: 'package tracker', desc: 'track all your packages in one app', img: 'pt-logo-512x512.webp', legal: 'package-tracking', wip: true },
];
%>
<section class="page">
  <div class="page-head"><h1 class="scr">apps</h1><span class="count">[<%= String(apps.length).padStart(2, '0') %>]</span></div>
  <ul class="rows">
    <% apps.forEach((p, i) => { %>
    <li class="row" data-img="/images/<%= p.img %>">
      <div class="item" tabindex="0">
        <span class="n"><%= String(i + 1).padStart(2, '0') %></span><span class="name"><%= p.name %></span><span class="arrow" aria-hidden="true"><%= p.wip ? '_' : '◇' %></span>
        <span class="desc"><%= p.desc %></span>
        <span class="tagline">
          <% if (p.wip) { %><button type="button" class="chip wip" data-modal="wip-modal">[ wip ]</button><% } %>
          <button type="button" class="chip dapp" data-modal="dapp-modal">dApp store only</button>
          <a href="/legal/<%= p.legal %>/copyright">copyright</a>
          <a href="/legal/<%= p.legal %>/licensing">licensing</a>
          <a href="/legal/<%= p.legal %>/privacy">privacy</a>
        </span>
      </div>
    </li>
    <% }) %>
  </ul>
  <a class="back" href="/">← back</a>
</section>
