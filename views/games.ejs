<%
const games = [
  { name: 'supercold', desc: 'superhot but cold and in browser', img: 'supercold.webp', url: 'https://supercold.leonimust.com' },
  { name: 'doom', desc: 'doom but in browser duh', img: 'doom.webp', url: 'https://doom.leonimust.com' },
  { name: 'earthwalker', desc: 'geoguessr without budget but free', img: 'earthwalker.webp', url: 'https://earthwalker.leonimust.com' },
];
%>
<section class="page">
  <div class="page-head"><h1 class="scr">games</h1><span class="count">[<%= String(games.length).padStart(2, '0') %>]</span></div>
  <ul class="rows">
    <% games.forEach((p, i) => { const down = !results[i] || results[i].statusText === 'Down'; %>
    <li class="row" data-img="/images/<%= p.img %>">
      <a href="<%= p.url %>" target="_blank" rel="noopener noreferrer">
        <span class="n"><%= String(i + 1).padStart(2, '0') %></span><span class="name"><%= p.name %></span><span class="arrow" aria-hidden="true">↗</span>
        <span class="desc"><%= p.desc %></span>
        <span class="tagline"><span class="chip <%= down ? 'down' : 'up' %>"><%= p.name %> is <%= down ? 'down' : 'up' %></span></span>
      </a>
    </li>
    <% }) %>
  </ul>
  <a class="back" href="/">← back</a>
</section>
