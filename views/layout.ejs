<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title><%= locals.title ? title + ' · leonimust.com' : 'leonimust.com' %></title>
        <meta name="description" content="leonimust's mini portfolio. web stuff, games, mobile apps.">
        <meta name="keywords" content="portfolio, leonimust">
        <meta name="author" content="LeonimusT">
        <meta name="theme-color" content="#0b0b0a">
        <meta property="og:title" content="leonimust.com">
        <meta property="og:description" content="mini portfolio. web stuff, games, mobile apps.">
        <meta property="og:type" content="website">
        <meta property="og:url" content="https://leonimust.com">
        <meta name="twitter:card" content="summary">
        <meta name="twitter:title" content="leonimust.com">
        <meta name="twitter:description" content="mini portfolio. web stuff, games, mobile apps.">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;700&display=swap">
        <link rel="stylesheet" href="/stylesheets/style.css">
        <noscript><style>#gate { display: none; } body:not(.entered) #main { visibility: visible; } .bar { opacity: 1; }</style></noscript>
    </head>
    <body data-view="<%= locals.view || 'home' %>">
        <audio id="music" src="/music/msc.mp3" preload="auto" loop></audio>
        <canvas id="field" aria-hidden="true"></canvas>

        <button id="gate" type="button" aria-label="click to enter (turns on sound)"><span class="hint">(turns on sound)</span></button>

        <header class="bar top">
            <span class="crumb"><a href="/">leonimust.com</a><span id="where"></span></span>
            <span class="sky-wrap"><span id="sky"></span><span id="clock" aria-hidden="true"></span></span>
        </header>

        <main id="main">
            <div class="view-root" data-view="<%= locals.view || 'home' %>">
                <%- body %>
            </div>
        </main>

        <footer class="bar bottom">
            <span>msc.mp3 <span id="spec" aria-hidden="true"></span></span>
            <div id="vol">
                <button id="mute" type="button" aria-label="mute">♪</button>
                <span id="volbar" role="slider" tabindex="0" aria-label="volume" aria-valuemin="0" aria-valuemax="100"></span>
                <span id="volnum"></span>
            </div>
        </footer>

        <dialog id="dapp-modal">
            <h3>solana mobile only</h3>
            <p>this app is exclusively available on the <strong style="color: var(--dapp)">dApp Store</strong> for Solana Mobile devices (Saga / Chapter 2).<br><br>it cannot be downloaded from a regular browser or app store.</p>
            <button type="button" data-close>got it</button>
        </dialog>
        <dialog id="wip-modal">
            <h3>work in progress</h3>
            <p>this project isn't accessible yet.<br><br>it's currently being built and will be available soon. stay tuned.</p>
            <button type="button" data-close>got it</button>
        </dialog>

        <script src="/javascripts/sound.js"></script>
        <script src="/javascripts/stipple.js"></script>
        <script src="/javascripts/orbit.js"></script>
        <script src="/javascripts/site.js"></script>
    </body>
</html>
