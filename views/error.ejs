<section class="error">
  <h1 class="title"><%= message %></h1>
  <% if (isDevelopment) { %>
  <p class="tag"><%= error.status %></p>
  <pre><%= error.stack %></pre>
  <% } else { %>
  <p class="tag">lost in space. the page you're looking for isn't on this orbit.</p>
  <% } %>
  <a class="back" href="/">← back home</a>
</section>
